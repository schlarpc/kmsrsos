# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Nix
result
result-*

# direnv
.direnv/

# Coverage reports
lcov.info
*.profraw
*.profdata
coverage/
htmlcov/

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Local environment overrides (if any)
.env.local
.envrc.local

# Artifacts downloaded by kmsrs-dbgen. Not committed: the generated
# products.toml records a digest per source instead, so a silently
# republished artifact shows up as a changed digest rather than as a
# 4 MB diff of Microsoft's files (DB-002, #126).
crates/kmsrs-dbgen/artifacts/

# The fuzzer's working corpus and its crash artifacts (SEC-004, #196).
# `fuzz/seeds/` is the committed input set and is generated from the golden
# vectors (TEST-006, #227); `fuzz/corpus/` is where libFuzzer accumulates the
# inputs it discovers from those seeds, which grows without bound and is
# machine-specific.
fuzz/corpus/
fuzz/artifacts/
fuzz/coverage/
